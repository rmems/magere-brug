{
  "recipe_id": "redpajama-ternary-pack-example",
  "type": "ternary_pack",
  "description": "Runnable example for `magere pack-goz1`: packs the mini dissect-manifest fixture into a GOZ1 shell. Run from the repository root with --output-dir pointing at a writable directory.",
  "inputs": {
    "source_manifest": "manifests/examples/redpajama-incite-7b-chat.json"
  },
  "outputs": {
    "generated_format": "goz1",
    "manifest_id": "redpajama-incite-7b-chat-goz1-v1",
    "output_dir": "/packs/redpajama"
  },
  "pack": {
    "dissect_manifest": "configs/recipes/fixtures/grok-mini-dissect.json",
    "input_dir": "/models/redpajama/INCITE-7B-Chat",
    "input_format": "safetensors",
    "gif_threshold": 0.05,
    "use_embedded_baseline": false
  }
}
