{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Model Quantization Manifest",
  "description": "Schema for magere-brug model registry and artifact tracking. Defines complete model metadata, source/generated artifacts, quantization parameters, and backend compatibility.",
  "type": "object",
  "required": [
    "metadata",
    "model",
    "source_artifact"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "description": "Manifest metadata and versioning",
      "required": [
        "schema_version",
        "created_at",
        "manifest_id"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "description": "Schema version for backwards compatibility",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of manifest creation"
        },
        "manifest_id": {
          "type": "string",
          "description": "Unique manifest identifier, typically <model_slug>-<version>"
        },
        "description": {
          "type": "string",
          "description": "Human-readable manifest description"
        }
      }
    },
    "model": {
      "type": "object",
      "description": "Model identity and architecture metadata",
      "required": [
        "slug",
        "name",
        "family",
        "parameter_count",
        "architecture"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "description": "Stable identifier for the model (e.g., olmoe_baseline)"
        },
        "name": {
          "type": "string",
          "description": "Human-readable model name"
        },
        "family": {
          "type": "string",
          "enum": [
            "olmoe",
            "gemma",
            "deepseek",
            "llama",
            "qwen",
            "nemotron",
            "redpajama",
            "granite",
            "trinity",
            "grok",
            "other"
          ],
          "description": "Model family classification"
        },
        "parameter_count": {
          "type": "object",
          "description": "Parameter counts",
          "required": [
            "active"
          ],
          "properties": {
            "active": {
              "type": "integer",
              "description": "Active parameter count (excluding shared weights)",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "description": "Total parameter count including shared weights",
              "minimum": 0
            }
          }
        },
        "architecture": {
          "type": "string",
          "enum": [
            "dense",
            "moe"
          ],
          "description": "Model architecture type"
        },
        "moe_layout": {
          "type": "object",
          "description": "MoE-specific metadata (required if architecture is moe)",
          "properties": {
            "expert_count": {
              "type": "integer",
              "description": "Number of experts",
              "minimum": 1
            },
            "capacity_factor": {
              "type": "number",
              "description": "Expert capacity factor",
              "minimum": 0.1
            },
            "routing_strategy": {
              "type": "string",
              "description": "Routing strategy (e.g., top-2, top-k)"
            }
          }
        }
      }
    },
    "source_artifact": {
      "type": "object",
      "description": "Source model artifact metadata",
      "required": [
        "format",
        "path"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "safetensors",
            "gguf",
            "hf_repo",
            "local_dir"
          ],
          "description": "Source artifact format"
        },
        "path": {
          "type": "string",
          "description": "Local filesystem path or HuggingFace repo ID (no home directory exposure)"
        },
        "source_url": {
          "type": "string",
          "description": "URL or reference to source (e.g., HF model card)"
        },
        "checksum": {
          "type": "object",
          "description": "Artifact checksums for verification",
          "properties": {
            "sha256": {
              "type": "string",
              "description": "SHA256 checksum"
            },
            "md5": {
              "type": "string",
              "description": "MD5 checksum"
            }
          }
        },
        "dtype_summary": {
          "type": "string",
          "enum": [
            "fp32",
            "fp16",
            "bf16",
            "f16",
            "int8",
            "int4",
            "q6_k",
            "q5_k",
            "mixed"
          ],
          "description": "Primary data type(s) in source"
        },
        "size_bytes": {
          "type": "integer",
          "description": "Total artifact size in bytes",
          "minimum": 0
        },
        "shard_info": {
          "type": "object",
          "description": "Information about artifact sharding (for safetensors)",
          "properties": {
            "shard_count": {
              "type": "integer",
              "minimum": 1
            },
            "shard_size_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "shard_paths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Relative paths to shard files"
            }
          }
        }
      }
    },
    "generated_artifact": {
      "type": "object",
      "description": "Generated artifact tracking (optional, populated after quantization)",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "awq",
            "gguf",
            "gptq",
            "ternary",
            "binary"
          ],
          "description": "Generated artifact format"
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "running",
            "success",
            "failed",
            "skipped"
          ],
          "description": "Generation status"
        },
        "path": {
          "type": "string",
          "description": "Path to generated artifact"
        },
        "checksum": {
          "type": "object",
          "description": "Generated artifact checksums",
          "properties": {
            "sha256": {
              "type": "string"
            },
            "md5": {
              "type": "string"
            }
          }
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Generation completion timestamp"
        }
      }
    },
    "quantization": {
      "type": "object",
      "description": "Quantization parameters",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "awq",
            "gptq",
            "gguf",
            "ternary",
            "binary",
            "none"
          ],
          "description": "Quantization method"
        },
        "bits": {
          "type": "integer",
          "enum": [
            1,
            2,
            3,
            4,
            5,
            6,
            8,
            16
          ],
          "description": "Quantization bit width"
        },
        "group_size": {
          "type": "integer",
          "description": "Group size for channel-wise quantization"
        },
        "calibration_dataset": {
          "type": "string",
          "description": "Reference to calibration dataset used"
        },
        "calibration_config_path": {
          "type": "string",
          "description": "Path to calibration configuration file"
        }
      }
    },
    "backend_compatibility": {
      "type": "object",
      "description": "Backend support matrix",
      "properties": {
        "safetensors": {
          "type": "object",
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "enum": [
                "proven",
                "testing",
                "planned",
                "not_applicable"
              ]
            }
          }
        },
        "gguf": {
          "type": "object",
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "enum": [
                "proven",
                "testing",
                "planned",
                "not_applicable"
              ]
            }
          }
        },
        "awq": {
          "type": "object",
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "enum": [
                "proven",
                "testing",
                "planned",
                "not_applicable"
              ]
            }
          }
        },
        "gptq": {
          "type": "object",
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "enum": [
                "proven",
                "testing",
                "planned",
                "not_applicable"
              ]
            }
          }
        },
        "myelin_accelerator": {
          "type": "object",
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "enum": [
                "proven",
                "testing",
                "planned",
                "not_applicable"
              ]
            },
            "kernel_types": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Supported kernel types (e.g., binary, ternary, saaq)"
            }
          }
        }
      }
    },
    "saaq_experiment": {
      "type": "object",
      "description": "SAAQ (Spiking Adaptive Activity Quantization) experiment metadata",
      "properties": {
        "saaq_version": {
          "type": "string",
          "description": "SAAQ version/rule (e.g., saaq_v1_5, legacy)"
        },
        "telemetry_source": {
          "type": "string",
          "description": "Telemetry collection source"
        },
        "routing_entropy_metrics": {
          "type": "object",
          "description": "Routing entropy and expert utilization metrics",
          "properties": {
            "expert_utilization": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "entropy_score": {
              "type": "number"
            },
            "load_balance_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "benchmark_linkage": {
      "type": "object",
      "description": "Linkage to downstream benchmarking pipelines",
      "properties": {
        "pipeline_id": {
          "type": "string",
          "description": "Identifier for downstream benchmark pipeline"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "queued",
            "running",
            "completed",
            "failed"
          ],
          "description": "Pipeline execution status"
        },
        "results_path": {
          "type": "string",
          "description": "Path to benchmark results (if completed)"
        }
      }
    }
  },
  "if": {
    "properties": {
      "model": {
        "properties": {
          "architecture": { "const": "moe" }
        }
      }
    }
  },
  "then": {
    "required": ["model"],
    "properties": {
      "model": {
        "required": ["moe_layout"]
      }
    }
  },
  "additionalProperties": false
}
