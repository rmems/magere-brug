{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "magere-brug Recipe",
  "description": "Recipe pipeline schema for registering existing artifacts and driving hybrid/ternary GOZ1 experiments. A recipe declares what to register, pack, optionally export to GGUF, or calibrate; it never contains model weights. `register` is implemented in `magere recipe apply` and emits artifact manifests plus combine-for-AI handoff files. `saaq` is implemented in `magere run-saaq` and is also reachable from `magere recipe apply`. Pack runners (`goz1_pack`/`ternary_pack`) are tracked by issue #19. `gguf_export` is an optional conversion placeholder \u2014 existing GGUF artifacts are registered without conversion. AWQ and GPTQ are removed comparison paths and are rejected everywhere in this schema.",
  "type": "object",
  "required": [
    "recipe_id",
    "type"
  ],
  "definitions": {
    "safe_string": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "[Aa][Ww][Qq]|[Gg][Pp][Tt][Qq]"
      },
      "description": "Non-empty string that must not name a removed quantization path (AWQ/GPTQ). The primary path is packable source -> ternary pack -> GOZ1 -> SAAQ."
    },
    "handoff_target": {
      "type": "object",
      "description": "Forward-declared handoff placeholder. magere-brug only records the intent and the artifact lineage; the named repository owns execution. Nothing here is executed by this repo.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether the downstream handoff is intended for this recipe"
        },
        "status": {
          "type": "string",
          "enum": [
            "placeholder",
            "planned",
            "ready"
          ],
          "description": "Handoff readiness. `placeholder` means the target is forward-declared only."
        },
        "kernel_types": {
          "type": "array",
          "description": "Kernel families the downstream repo is expected to exercise",
          "items": {
            "type": "string",
            "enum": [
              "ternary",
              "binary",
              "saaq"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "pipeline_id": {
          "description": "Downstream pipeline identifier (e.g. a combine-for-AI benchmark pipeline)",
          "allOf": [
            {
              "$ref": "#/definitions/safe_string"
            }
          ]
        },
        "notes": {
          "description": "Free-form note about the forward-declared handoff",
          "allOf": [
            {
              "$ref": "#/definitions/safe_string"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "recipe_id": {
      "description": "Stable recipe identifier",
      "allOf": [
        {
          "$ref": "#/definitions/safe_string"
        }
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "register",
        "goz1_pack",
        "ternary_pack",
        "gguf_export",
        "saaq"
      ],
      "description": "Recipe kind. `register` records an existing source artifact (GGUF, safetensors, HF repo, local dir) without conversion. `goz1_pack`/`ternary_pack` describe packing runs (runner: issue #19). `gguf_export` is an optional GGUF conversion placeholder; existing GGUF files skip this step. `saaq` describes an SAAQ validation run (`magere run-saaq`)."
    },
    "description": {
      "description": "Human-readable summary of the recipe",
      "allOf": [
        {
          "$ref": "#/definitions/safe_string"
        }
      ]
    },
    "inputs": {
      "type": "object",
      "description": "Input references for the recipe",
      "properties": {
        "source_manifest": {
          "description": "Path to the source model manifest (a `*.json` path is resolved and parsed) or a registry id",
          "allOf": [
            {
              "$ref": "#/definitions/safe_string"
            }
          ]
        },
        "source_format": {
          "type": "string",
          "enum": [
            "gguf",
            "safetensors",
            "hf_repo",
            "local_dir"
          ],
          "description": "Expected `source_artifact.format` of the referenced manifest. Declaring it turns the recipe into an assertion: validation fails when the manifest disagrees."
        },
        "goz1_ref": {
          "description": "Path to a manifest carrying a registered GOZ1 pack, or a registry id (for post-pack steps such as SAAQ)",
          "allOf": [
            {
              "$ref": "#/definitions/safe_string"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "description": "Expected outputs and registration behaviour",
      "properties": {
        "generated_format": {
          "type": "string",
          "enum": [
            "goz1",
            "gguf",
            "ternary",
            "binary"
          ],
          "description": "Format of the primary generated artifact; prefer goz1"
        },
        "manifest_id": {
          "description": "Manifest id to write or update after the recipe runs",
          "allOf": [
            {
              "$ref": "#/definitions/safe_string"
            }
          ]
        },
        "output_dir": {
          "description": "Directory for pack or SAAQ run outputs",
          "allOf": [
            {
              "$ref": "#/definitions/safe_string"
            }
          ]
        },
        "artifact_path": {
          "description": "Expected on-disk path of the emitted artifact (e.g. the `.goz1` file)",
          "allOf": [
            {
              "$ref": "#/definitions/safe_string"
            }
          ]
        },
        "goz1_version": {
          "type": "integer",
          "description": "GOZ1 pack format version to emit; must match the writer in magere-grok-process (currently 1)",
          "enum": [
            1
          ]
        },
        "checksum_algorithm": {
          "type": "string",
          "enum": [
            "sha256"
          ],
          "description": "Checksum recorded for the emitted artifact"
        },
        "register": {
          "type": "boolean",
          "description": "When true, the runner writes/updates the artifact manifest and adds it to the artifact registry"
        },
        "registry_path": {
          "description": "Registry file to write when `register` is true; the CLI `--registry` flag overrides it",
          "allOf": [
            {
              "$ref": "#/definitions/safe_string"
            }
          ]
        },
        "lineage": {
          "type": "object",
          "description": "Provenance recorded on the emitted artifact so a pack can be traced back to its source",
          "properties": {
            "parent_manifest_id": {
              "description": "Manifest id of the artifact this output was derived from",
              "allOf": [
                {
                  "$ref": "#/definitions/safe_string"
                }
              ]
            },
            "parent_path": {
              "description": "On-disk path of the artifact this output was derived from",
              "allOf": [
                {
                  "$ref": "#/definitions/safe_string"
                }
              ]
            },
            "recipe_id": {
              "description": "Recipe that produced the output; normally equal to the top-level `recipe_id`",
              "allOf": [
                {
                  "$ref": "#/definitions/safe_string"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "calibration": {
      "type": "object",
      "description": "Calibration dataset configuration. Only meaningful for the ternary/GOZ1 pack and SAAQ paths; `register` recipes must not carry it.",
      "required": [
        "dataset"
      ],
      "properties": {
        "dataset": {
          "description": "Calibration dataset name (e.g. wikitext-2, math_logic)",
          "allOf": [
            {
              "$ref": "#/definitions/safe_string"
            }
          ]
        },
        "dataset_path": {
          "description": "Path to the calibration corpus",
          "allOf": [
            {
              "$ref": "#/definitions/safe_string"
            }
          ]
        },
        "config_path": {
          "description": "Path to a calibration config file (mirrors `quantization.calibration_config_path` in a manifest)",
          "allOf": [
            {
              "$ref": "#/definitions/safe_string"
            }
          ]
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of calibration samples to draw"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "description": "Deterministic seed for calibration sampling"
        }
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "description": "Forward-declared handoff placeholders for downstream repositories. magere-brug does not execute any of these; they exist so a recipe can carry the intent and lineage across repo boundaries.",
      "properties": {
        "myelin_accelerator": {
          "description": "CUDA kernel execution target (repo: myelin-accelerator)",
          "allOf": [
            {
              "$ref": "#/definitions/handoff_target"
            }
          ]
        },
        "corinth_canal": {
          "description": "Reference SAAQ implementation target (repo: corinth-canal)",
          "allOf": [
            {
              "$ref": "#/definitions/handoff_target"
            }
          ]
        },
        "combine_for_ai": {
          "description": "Benchmark scoring target (repo: combine-for-AI)",
          "allOf": [
            {
              "$ref": "#/definitions/handoff_target"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "saaq": {
      "type": "object",
      "description": "SAAQ runner configuration, consumed by `magere run-saaq` for recipes of type \"saaq\". Drives the CPU-only validation pipeline in magere-corinth-core (TelemetrySnapshot -> TelemetryFunnel -> Projector -> SnnLatentCalibrator). Every field has a documented default, so a thin saaq stub still runs.",
      "properties": {
        "projection_mode": {
          "type": "string",
          "enum": [
            "RateSum",
            "TemporalHistogram",
            "MembraneSnapshot",
            "SpikingTernary"
          ],
          "default": "SpikingTernary",
          "description": "Projector strategy used to turn hidden spike activity into the dense embedding (magere-corinth-core ProjectionMode)."
        },
        "snn_steps": {
          "type": "integer",
          "minimum": 1,
          "default": 20,
          "description": "SNN time-steps expanded per telemetry snapshot by the telemetry funnel."
        },
        "thresholds": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 4,
          "maxItems": 4,
          "default": [
            1.0,
            5.0,
            1.0,
            5.0
          ],
          "description": "Per-channel TelemetryEncoder thresholds, in channel order: gpu_temp_c, gpu_power_w, cpu_tctl_c, cpu_package_power_w."
        },
        "update_rule": {
          "type": "string",
          "enum": [
            "LegacyV1_0",
            "SaaqV1_5SqrtRate"
          ],
          "default": "LegacyV1_0",
          "description": "SAAQ delta-Q update rule (magere-corinth-core SaaqUpdateRule). Under dual_rule it selects which rule fills the legacy saaq_delta_q_{prev,target} columns."
        },
        "dual_rule": {
          "type": "boolean",
          "default": false,
          "description": "Observe both SAAQ rules through SnnDualLatentCalibrator so each CSV row carries the legacy and v1.5 trajectories side by side."
        },
        "num_experts": {
          "type": "integer",
          "minimum": 2,
          "default": 8,
          "description": "PLACEHOLDER SURROGATE - not the model's real MoE router. Number of contiguous proportional projector-embedding slices whose per-slice means are softmaxed to derive the routing distribution behind the routing_entropy column. The proportional boundaries partition every embedding position and slice widths differ by at most one. Derived only from telemetry-driven SNN activity; no model weights are read. Capped at the projector embedding dim (2048) so every expert owns at least one position. Note routing_entropy stays within ~1% of its uniform maximum over a typical run, so treat it as a recorded diagnostic rather than a live routing signal.",
          "maximum": 2048
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Recorded-only provenance: experts listed in selected_experts each tick; must not exceed num_experts. The calibrator reads only expert_weights, so top_k cannot change latent_telemetry.csv - runs differing only in top_k are byte-identical. It documents the intended routing fan-out for the downstream handoff."
        },
        "telemetry": {
          "type": "object",
          "description": "Source of the TelemetrySnapshot stream. Defaults to a synthetic ramp so a checked-in recipe runs with no external data.",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "synthetic",
                "csv"
              ],
              "default": "synthetic",
              "description": "synthetic: each snapshot is a pure function of the tick index (no RNG, no wall clock, byte-reproducible CSV). csv: snapshots are replayed from the file at `path`."
            },
            "ticks": {
              "type": "integer",
              "minimum": 1,
              "default": 16,
              "description": "synthetic only - number of telemetry ticks to replay; equals the emitted CSV row count."
            },
            "tick_interval_ms": {
              "type": "integer",
              "minimum": 1,
              "default": 250,
              "description": "synthetic only - milliseconds between ticks; also fixes the emitted timestamp_ms column."
            },
            "start_timestamp_ms": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "synthetic only - timestamp_ms of tick 0. Recipe-derived, never read from the system clock."
            },
            "start": {
              "type": "object",
              "description": "synthetic only - channel values at tick 0.",
              "required": [
                "gpu_temp_c",
                "gpu_power_w",
                "cpu_tctl_c",
                "cpu_package_power_w"
              ],
              "properties": {
                "gpu_temp_c": {
                  "type": "number"
                },
                "gpu_power_w": {
                  "type": "number"
                },
                "cpu_tctl_c": {
                  "type": "number"
                },
                "cpu_package_power_w": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "delta": {
              "type": "object",
              "description": "synthetic only - per-tick channel increment; channel c at tick i is start.c + delta.c * i.",
              "required": [
                "gpu_temp_c",
                "gpu_power_w",
                "cpu_tctl_c",
                "cpu_package_power_w"
              ],
              "properties": {
                "gpu_temp_c": {
                  "type": "number"
                },
                "gpu_power_w": {
                  "type": "number"
                },
                "cpu_tctl_c": {
                  "type": "number"
                },
                "cpu_package_power_w": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "csv only - telemetry CSV carrying the columns timestamp_ms, gpu_temp_c, gpu_power_w, cpu_tctl_c and cpu_package_power_w in any order."
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "source": {
                    "const": "csv"
                  }
                },
                "required": [
                  "source"
                ]
              },
              "then": {
                "required": [
                  "path"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "ticks"
                      ]
                    },
                    {
                      "required": [
                        "tick_interval_ms"
                      ]
                    },
                    {
                      "required": [
                        "start_timestamp_ms"
                      ]
                    },
                    {
                      "required": [
                        "start"
                      ]
                    },
                    {
                      "required": [
                        "delta"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "source": {
                    "const": "synthetic"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "path"
                  ]
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "goz1_pack",
              "ternary_pack"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "inputs",
          "outputs"
        ],
        "properties": {
          "inputs": {
            "required": [
              "source_manifest"
            ],
            "properties": {
              "source_format": {
                "enum": [
                  "safetensors",
                  "local_dir"
                ]
              }
            }
          },
          "outputs": {
            "required": [
              "generated_format"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "goz1_pack"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "outputs": {
            "properties": {
              "generated_format": {
                "const": "goz1"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ternary_pack"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "outputs": {
            "properties": {
              "generated_format": {
                "enum": [
                  "goz1",
                  "ternary"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "saaq"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "inputs",
          "outputs"
        ],
        "properties": {
          "inputs": {
            "anyOf": [
              {
                "required": [
                  "source_manifest"
                ]
              },
              {
                "required": [
                  "goz1_ref"
                ]
              }
            ]
          },
          "outputs": {
            "required": [
              "output_dir"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "register"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "inputs"
        ],
        "properties": {
          "inputs": {
            "required": [
              "source_manifest"
            ]
          },
          "outputs": {
            "properties": {
              "register": {
                "const": true
              }
            }
          }
        },
        "not": {
          "required": [
            "calibration"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "goz1_pack",
              "ternary_pack"
            ]
          },
          "outputs": {
            "type": "object",
            "required": [
              "register"
            ],
            "properties": {
              "register": {
                "const": true
              }
            }
          }
        },
        "required": [
          "type",
          "outputs"
        ]
      },
      "then": {
        "properties": {
          "outputs": {
            "required": [
              "manifest_id",
              "artifact_path"
            ]
          }
        }
      }
    },
    {
      "$comment": "outputs.goz1_version is only meaningful for a GOZ1 output.",
      "if": {
        "properties": {
          "outputs": {
            "type": "object",
            "required": [
              "goz1_version"
            ]
          }
        },
        "required": [
          "outputs"
        ]
      },
      "then": {
        "properties": {
          "outputs": {
            "required": [
              "generated_format"
            ],
            "properties": {
              "generated_format": {
                "const": "goz1"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "gguf_export"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "inputs",
          "outputs"
        ],
        "properties": {
          "inputs": {
            "required": [
              "source_manifest"
            ],
            "properties": {
              "source_format": {
                "enum": [
                  "safetensors",
                  "hf_repo",
                  "local_dir"
                ]
              }
            }
          },
          "outputs": {
            "required": [
              "generated_format"
            ],
            "properties": {
              "generated_format": {
                "const": "gguf"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "type": {
              "const": "saaq"
            }
          },
          "required": [
            "type"
          ]
        }
      },
      "then": {
        "not": {
          "required": [
            "saaq"
          ]
        }
      }
    }
  ]
}
